MOLT_SERVER_ENVIRONMENT="local"  # one of local, development, staging, production

# --- LLM ---------------------------------------------------------------------
# Default model for every agentic tool. Format: "<provider>:<model-id>".
# Examples: anthropic:claude-opus-5 | openai:gpt-5.5 | ollama:llama3.1
MOLT_SERVER_DEFAULT_LLM_MODEL="anthropic:claude-opus-5"
# Leave temperature unset unless the provider accepts it — Anthropic reasoning
# models (claude-opus-5 and friends) reject it with a 400.
# MOLT_SERVER_DEFAULT_LLM_TEMPERATURE=0.0

# Provider API Key
ANTHROPIC_API_KEY=  # fill in if anthropic:* model is used
OPENAI_API_KEY=     # fill in if openai:* model is used

# Per-tool overrides win over the defaults above. Set only what you want to differ.
# One tool per agent: assess_security, assess_license, assess_maintenance,
# triage_dependencies, find_replacement.
# MOLT_SERVER_ASSESS_SECURITY_LLM_MODEL="anthropic:claude-opus-5"
# MOLT_SERVER_ASSESS_SECURITY_LLM_MAX_TOKENS=4096
# MOLT_SERVER_ASSESS_LICENSE_LLM_MODEL="openai:gpt-5.5"
# MOLT_SERVER_ASSESS_MAINTENANCE_LLM_MODEL="ollama:llama3.1"
# MOLT_SERVER_TRIAGE_DEPENDENCIES_LLM_MODEL="anthropic:claude-opus-5"
# MOLT_SERVER_FIND_REPLACEMENT_LLM_MODEL="anthropic:claude-opus-5"

# --- Retrieval (RAG over the SPDX clause corpus) ------------------------------
# chroma  : embeddings in a persistent local collection (downloads a ~80MB ONNX
#           model on first use, then works offline)
# lexical : TF-IDF over the same passages; no model, no network
# off     : no retrieval tool at all — useful for measuring what retrieval buys
MOLT_SERVER_RAG_BACKEND="chroma"
MOLT_SERVER_RAG_TOP_K=3
# MOLT_SERVER_RAG_PERSIST_DIRECTORY="~/.molt/chroma"
# MOLT_SERVER_RAG_COLLECTION="molt-license-clauses"

# --- Storage -----------------------------------------------------------------
# The 24h enrichment cache and the long-term memory share one SQLite file.
# MOLT_SERVER_CACHE_PATH="~/.molt/molt.db"
# MOLT_SERVER_MEMORY_PATH="~/.molt/molt.db"

# --- Identity ----------------------------------------------------------------
# MOLT_SERVER_APP_NAME="molt"
# MOLT_SERVER_VERSION="0.1.0"

# --- Transport -----------------------------------------------------------------
# http  : runs as a standalone process you start yourself; every tool call is
#         logged live in that terminal, and any client (Claude Code, Inspector)
#         connects to it over the network.
# stdio : spawned as a child process per client, one instance per session, no
#         shared console.
# MOLT_SERVER_TRANSPORT="http"
# MOLT_SERVER_HOST="127.0.0.1"
# MOLT_SERVER_PORT=8000
